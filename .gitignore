# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments and local dependency caches
.venv/
venv/
env/
ENV/
.uv-cache/
.pip-cache/

# Jupyter/IPython local state
.ipynb_checkpoints/
.ipython/

# Local editor/agent state and development scratch space. These are never
# research artifacts and must not enter a release commit.
.codex/
.agents/
.cursor/
.vscode/
.idea/
work/
scratch/
debug/
tmp/

# Experiment outputs. The repository keeps configurations, code, README files,
# and final report PDFs; raw rows and regenerated plots remain local.
**/results/
**/results/raw/**
**/results/summary/**
**/results/figures/**
**/results/summary_certificate/**
**/results/figures_certificate/**
**/results/smoke_certificate/**
**/results/fixed_confidence/**
**/results/audits/**
!**/results/raw/.gitkeep
!**/results/summary/.gitkeep
!**/results/figures/.gitkeep

# Large/generated numeric artifacts
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.jsonl

# Logs and temporary files
*.log
*.aux
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.tmp
*.temp
*.bak
*.swp
*.swo
~$*

# OS/editor metadata
.DS_Store
Thumbs.db
desktop.ini
# Main synthetic report deliverable. The generator lives in scripts/.
report/**
!report/
!report/synthetic_fixed_confidence_report.pdf

# Historical exploratory extensions are intentionally not part of the paper
# release. Keep only the explicitly tracked, documented core files.
pilot_focal_bt_mle/**
!pilot_focal_bt_mle/
!pilot_focal_bt_mle/__init__.py
!pilot_focal_bt_mle/README.md
!pilot_focal_bt_mle/matched_fixed_budget.py
!pilot_focal_bt_mle/test_matched_fixed_budget.py

# The formal report has one curated PDF plus its tracked generator. Alternate
# drafts, smoke reports, and TeX build products remain local.
icml_pareto_track_stop/report/**
!icml_pareto_track_stop/report/
!icml_pareto_track_stop/report/build_certificate_v1_formal_report.py
!icml_pareto_track_stop/report/formal_certificate_v1_report.pdf
